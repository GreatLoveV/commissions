# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection string.
# The default below matches docker-compose.yml (local only).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/commissions"

# Secret used to sign session cookies. At least 32 random characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Base URL of the app
BETTER_AUTH_URL="http://localhost:3000"
