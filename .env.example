# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection string.
# The default below matches docker-compose.yml (local only).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/commissions"

# Secret used to sign session cookies. At least 32 random characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Base URL of the app
BETTER_AUTH_URL="http://localhost:3000"

# Email (Resend, free plan). Leave empty in development and emails are
# printed in the terminal instead of being sent.
# EMAIL_FROM must use a domain you verified in Resend, for example:
# "Commissions <hello@yourdomain.com>"
RESEND_API_KEY=""
EMAIL_FROM=""

# Image storage (Cloudinary, free plan). Leave empty in development and
# uploads are saved to the .uploads folder instead.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
