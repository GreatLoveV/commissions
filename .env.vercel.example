# Production values for Vercel. This file is ignored by git (.env*).
# Fill in the blanks, then paste the whole file into
# Vercel > Project > Settings > Environment Variables (it accepts a pasted .env).
# Keep a copy of BETTER_AUTH_SECRET somewhere safe: losing it breaks every client link.

# DATABASE_URL is already set by the Neon storage integration, do not add it again.
# DIRECT_URL: copy the value of DATABASE_URL_UNPOOLED from the Vercel env var list:
DIRECT_URL=

BETTER_AUTH_SECRET=your_better_auth_secret_here
# The Vercel address, no slash at the end:
BETTER_AUTH_URL=https://your-app.vercel.app

# Cloudinary > Dashboard (Product environment credentials):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend > API Keys. Without a verified domain use onboarding@resend.dev,
# and Resend will only deliver to the email you signed up with.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
